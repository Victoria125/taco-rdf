<https://w3id.org/taco-rdf/imports/cdno-module> a owl:Ontology ;
    dcterms:description "The CDNO classes targeted by the TACO nutrient alignments and all their named superclasses (rdfs:subClassOf and labels only), extracted by scripts/extract_cdno_module.py."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/3.0/> ;
    dcterms:source <https://github.com/CompositionalDietaryNutritionOntology/cdno> ;
    dcterms:title "CDNO module for taco-rdf"@en ;
    rdfs:comment "Omits the release axiom http://purl.obolibrary.org/obo/CDNO_0200627 rdfs:subClassOf http://purl.obolibrary.org/obo/CDNO_0200619: concentration of organosulfur compound is_a concentration of dietary sulfur would place methionine and cysteine under mineral nutrient."@en ;
    owl:versionIRI <http://purl.obolibrary.org/obo/cdno/releases/2026-06-10/cdno.owl> ;
    prov:wasDerivedFrom <http://purl.obolibrary.org/obo/cdno/releases/2026-06-10/cdno.owl> .

