@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fio: <http://www.foodvoc.org/resource/fio#> .
@prefix nevonut: <https://data.rivm.nl/data/nvip/bigfood/nevo/nutrient#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix om: <http://www.ontology-of-units-of-measure.org/resource/om-2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/taco-rdf/id/food/574> a obo:FOODON_00005279,
        fio:FoodItem ;
    dcterms:identifier "574" ;
    dcterms:isVersionOf <https://nepa.unicamp.br/tabela-brasileira-de-composicao-de-alimentos-4a-edicao/> ;
    fio:hasNutritionalValue <https://w3id.org/taco-rdf/id/measurement/574/available_carbohydrate>,
        <https://w3id.org/taco-rdf/id/measurement/574/energy_kcal>,
        <https://w3id.org/taco-rdf/id/measurement/574/lipids>,
        <https://w3id.org/taco-rdf/id/measurement/574/magnesium>,
        <https://w3id.org/taco-rdf/id/measurement/574/protein> ;
    skos:prefLabel "Bean, roxo (red), raw"@en,
        "Feijão, roxo, cru"@pt .

<https://w3id.org/taco-rdf/id/measurement/574/available_carbohydrate> a obo:CDNO_0200033,
        fio:NutritionalValue ;
    dcterms:description "Available carbohydrate by difference: TACO's carbohydrate minus its dietary fibre."@en ;
    fio:hasNutrient nevonut:CHO ;
    om:hasValue <https://w3id.org/taco-rdf/id/measurement/574/available_carbohydrate/measure> ;
    prov:wasDerivedFrom <https://w3id.org/taco-rdf/id/measurement/574/carbohydrate>,
        <https://w3id.org/taco-rdf/id/measurement/574/dietary_fiber> .

<https://w3id.org/taco-rdf/id/measurement/574/available_carbohydrate/measure> a om:Measure ;
    om:hasNumericalValue 26.143334 ;
    om:hasUnit om:gramPerHectogram,
        "g"^^xsd:string .

<https://w3id.org/taco-rdf/id/measurement/574/energy_kcal> a fio:NutritionalValue ;
    fio:hasNutrient nevonut:ENERCC ;
    om:hasValue <https://w3id.org/taco-rdf/id/measurement/574/energy_kcal/measure> .

<https://w3id.org/taco-rdf/id/measurement/574/energy_kcal/measure> a om:Measure ;
    om:hasNumericalValue 331.414977 ;
    om:hasUnit om:kilocaloriePerHectogram,
        "kcal"^^xsd:string .

<https://w3id.org/taco-rdf/id/measurement/574/lipids> a obo:CDNO_0200068,
        fio:NutritionalValue ;
    fio:hasNutrient nevonut:FAT ;
    om:hasValue <https://w3id.org/taco-rdf/id/measurement/574/lipids/measure> .

<https://w3id.org/taco-rdf/id/measurement/574/lipids/measure> a om:Measure ;
    om:hasNumericalValue 1.236667 ;
    om:hasUnit om:gramPerHectogram,
        "g"^^xsd:string .

<https://w3id.org/taco-rdf/id/measurement/574/magnesium> a obo:CDNO_0200570,
        fio:NutritionalValue ;
    fio:hasNutrient nevonut:MG ;
    om:hasValue <https://w3id.org/taco-rdf/id/measurement/574/magnesium/measure> .

<https://w3id.org/taco-rdf/id/measurement/574/magnesium/measure> a om:Measure ;
    om:hasNumericalValue 161.935333 ;
    om:hasUnit om:milligramPerHectogram,
