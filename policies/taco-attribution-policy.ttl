@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix tacoid:  <https://w3id.org/taco-rdf/id/> .

tacoid:policy\/attribution a odrl:Set ;
    odrl:uid tacoid:policy\/attribution ;
    rdfs:comment """Reuse of the TACO graph with attribution. Encodes the terms printed in the official TACO 4th
edition (p. ii-iii): "É permitida a reprodução parcial ou total desta obra, desde que citada a fonte"
(total or partial reproduction is allowed provided the source is cited), checked on 2026-09-23.
The graph itself is also released under CC BY 4.0, which carries the same attribution duty."""@en ;
    dcterms:source <https://nepa.unicamp.br/wp-content/uploads/sites/27/2023/10/taco_4_edicao_ampliada_e_revisada.pdf> ;
    odrl:permission [
        a odrl:Permission ;
        odrl:target tacoid:dataset ;
        odrl:action odrl:use, odrl:reproduce, odrl:distribute, odrl:derive ;
        odrl:duty [
            a odrl:Duty ;
            odrl:action odrl:attribute ;
            rdfs:comment "Cite the source table (see dcterms:bibliographicCitation on tacoid:source) and mention that values were converted to RDF."@en
        ]
    ] .
