PREFIX taco:    <https://w3id.org/taco-rdf/vocab#>
PREFIX tacoid:  <https://w3id.org/taco-rdf/id/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX qudt:    <http://qudt.org/schema/qudt/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov:    <http://www.w3.org/ns/prov#>

SELECT ?food_number ?food ?group ?value ?unit ?food_en
WHERE {
  ?n skos:notation ?key .
  ?m taco:ofNutrient ?n ;
     taco:ofFood ?f ;
     taco:valueStatus taco:Measured ;
     qudt:numericValue ?value ;
     qudt:unit ?u .
  ?f taco:foodNumber ?food_number ;
     rdfs:label ?food ;
     taco:inGroup/skos:prefLabel ?group .
  FILTER (LANG(?food) = "pt" && LANG(?group) = "en")
  BIND (STRAFTER(STR(?u), "unit/") AS ?unit)
  OPTIONAL { ?f skos:prefLabel ?food_en . FILTER (LANG(?food_en) = "en") }
}
ORDER BY DESC(?value)
LIMIT 10
