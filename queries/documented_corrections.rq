PREFIX taco:    <https://w3id.org/taco-rdf/vocab#>
PREFIX tacoid:  <https://w3id.org/taco-rdf/id/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX qudt:    <http://qudt.org/schema/qudt/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov:    <http://www.w3.org/ns/prov#>

SELECT ?food ?nutrient ?value ?origin ?note ?food_en
WHERE {
  ?m taco:valueOrigin ?o ;
     taco:ofFood ?f ;
     taco:ofNutrient ?n .
  OPTIONAL { ?m qudt:numericValue ?value }
  OPTIONAL { ?m skos:editorialNote ?note }
  ?f rdfs:label ?food .
  ?n skos:prefLabel ?nutrient .
  FILTER (LANG(?food) = "pt" && LANG(?nutrient) = "en")
  BIND (STRAFTER(STR(?o), "#") AS ?origin)
  OPTIONAL { ?f skos:prefLabel ?food_en . FILTER (LANG(?food_en) = "en") }
}
ORDER BY ?origin ?f ?nutrient
